{
  "name": "codex-reset-monitor-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "codex-reset-monitor",
      "database_id": "replace-with-your-d1-database-id",
      "migrations_dir": "../drizzle"
    }
  ],
  "vars": {
    "ALLOWED_ORIGIN": "http://localhost:3000"
  }
}
